<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL" Id="{816111f0-16ef-4f4d-a70e-f3df38e5b1aa}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL

    // ── Signals FROM PLCSim (declare as inputs AT %I*)
    ixAGVStrobe   AT %I*: BOOL;   (* AGV strobe from Slave *)
    iiAtPos       AT %I*: INT;    (* Position feedback from Slave *)

    // ── Signals TO PLCSim (declare as outputs AT %Q*)
    ixPLCStrobe   AT %Q*: BOOL;   (* Our strobe sent to Slave *)
    iiGotoPos     AT %Q*: INT;    (* Target position to Slave *)

    // ── HMI and internal vars — no address needed 
    ixStart         : BOOL;
    ixStop          : BOOL;
    ixReset         : BOOL;
    oxCurrentPos    : INT;
    qxReadyLed      : BOOL;
    qxMoveLed       : BOOL;
    qxStopLED       : BOOL;
    qxStartButton   : BOOL;
    qxStopNow       : BOOL;
    ixStopPressed   : BOOL;
    ixResetPressed  : BOOL;
    ixIndicatorCon  : BOOL;
    qxIndicator     : INT;
    sPosition       : STRING;

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>